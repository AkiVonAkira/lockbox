# Lockbox settings. `cp .env.example .env && docker compose up` runs it at http://localhost:3000 as is.
# Empty values are unset. For `npm run dev`, copy this to .env.local instead.

# --- Where Lockbox answers ---------------------------------------------------------------------
# Viewers open shares on LOCKBOX_PUBLIC_URL, which serves only the PIN pages. The admin page,
# sign-in, and the upload and stats APIs answer only on LOCKBOX_ADMIN_URL. Use one URL for both to
# serve everything on one name. Use the URL the browser sees: a TLS proxy in front is fine.
# With both unset, both are http://localhost:3000. With only the public one set, the admin page and
# uploads answer nowhere.
LOCKBOX_PUBLIC_URL="http://localhost:3000"
LOCKBOX_ADMIN_URL="http://localhost:3000"

# Host port for compose.yaml. The container listens on 3000.
LOCKBOX_PORT=3000

# --- Keys and tokens ---------------------------------------------------------------------------
# 32 random bytes, base64: `openssl rand -base64 32`. Seals every PIN and item at rest.
# Losing or changing it makes every share unreadable. Unset, Lockbox makes one in the data
# directory (lockbox.key), so anyone with the data volume can open the shares. Set it for real use.
LOCKBOX_KEY=

# Bearer token for POST /api/shares (uploads), 32 characters or more: `openssl rand -hex 32`.
# Unset, uploads are refused.
LOCKBOX_SERVICE_TOKEN=

# Read-only bearer token for GET /api/stats ({ total, active }), 32 characters or more. Unset, refused.
LOCKBOX_STATS_TOKEN=

# --- Admin sign-in (any OpenID Connect provider) -----------------------------------------------
# Auth.js session secret: `openssl rand -base64 32`. Needed for the admin page.
AUTH_SECRET=

# The provider's issuer URL, and this app's client id and secret there. Without all three, nobody
# can sign in. Register the redirect URI <LOCKBOX_ADMIN_URL>/api/auth/callback/oidc.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Scopes to ask for. The groups claim must be in the ID token or userinfo; some providers need a
# `groups` scope for that (Authelia, Keycloak with a mapper). Default: "openid profile".
AUTH_OIDC_SCOPE="openid profile"

# The claim that lists the person's groups, and the group that may use the admin page.
AUTH_OIDC_GROUPS_CLAIM=groups
AUTH_OIDC_ADMIN_GROUP=Admin

# Optional: the sign-in button's label, and the Auth.js provider id (it sets the callback path).
AUTH_OIDC_NAME=
AUTH_OIDC_PROVIDER_ID=

# Older names, still read when the AUTH_OIDC_* ones are unset: AUTH_AUTHENTIK_ISSUER,
# AUTH_AUTHENTIK_ID, AUTH_AUTHENTIK_SECRET. With them, the provider id is `authentik`.

# --- Storage -----------------------------------------------------------------------------------
# Where the SQLite file lives. The Docker image sets /data, which compose.yaml mounts as a volume.
# Outside Docker it defaults to .data/.
# LOCKBOX_DATA_DIR=.data

# scripts/backup.mjs only: an existing directory for the daily copies. It keeps the newest 14.
# LOCKBOX_BACKUP_DIR=/backups

# --- Development -------------------------------------------------------------------------------
# `next dev` only: use the admin page without sign-in. Production builds ignore it.
# LOCKBOX_DEV_ADMIN=1
