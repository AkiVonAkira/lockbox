# Auth.js. Generate the secret with `npx auth secret`. Required in production for the admin page.
AUTH_SECRET="replace-me"

# Authentik OAuth2/OpenID provider for Lockbox, bound to the Admin group. Without all three, nobody can sign in.
AUTH_AUTHENTIK_ID="lockbox"
AUTH_AUTHENTIK_SECRET="replace-me"
AUTH_AUTHENTIK_ISSUER="https://auth.example/application/o/lockbox/"

# 32 random bytes, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Seals every PIN and item. Losing it makes every share unreadable; changing it does the same.
LOCKBOX_KEY="replace-me"

# Agents' bearer token for POST /api/shares on lockbox.internal, 32 characters or more.
LOCKBOX_SERVICE_TOKEN="replace-me"

# Astrarium's bearer token for GET /api/stats on lockbox.internal, 32 characters or more. It reads counts only.
LOCKBOX_STATS_TOKEN=""

# Where the SQLite file lives. Defaults to .data/. Deployed, /data on a Coolify volume.
LOCKBOX_DATA_DIR=".data"

# scripts/backup.mjs only: an existing directory for the nightly copies. Deployed, /cloud/backups on NFS.
LOCKBOX_BACKUP_DIR="/cloud/backups"

# Where links Lockbox hands out point. Defaults to https://lockbox.kayzel.com.
LOCKBOX_PUBLIC_URL="https://lockbox.kayzel.com"

# `next dev` only: use the admin page without Authentik. Production builds ignore it.
LOCKBOX_DEV_ADMIN="1"
